<vm name="toy">
  <binaryOptions>
    <configurationOption>
      <name>root</name>
      <parent></parent>
      <optional>False</optional>
    </configurationOption>
    <configurationOption>
      <name>Compression</name>
      <parent>root</parent>
      <optional>True</optional>
    </configurationOption>
    <configurationOption>
      <name>Encryption</name>
      <parent>root</parent>
      <optional>True</optional>
    </configurationOption>
    <configurationOption>
      <name>Engine</name>
      <parent>root</parent>
      <optional>False</optional>
    </configurationOption>
    <configurationOption>
      <name>EngineA</name>
      <parent>Engine</parent>
      <excludedOptions><option>EngineB</option></excludedOptions>
      <optional>False</optional>
    </configurationOption>
    <configurationOption>
      <name>EngineB</name>
      <parent>Engine</parent>
      <excludedOptions><option>EngineA</option></excludedOptions>
      <optional>False</optional>
    </configurationOption>
    <configurationOption>
      <name>Logging</name>
      <parent>root</parent>
      <impliedOptions><option>Compression</option></impliedOptions>
      <optional>True</optional>
    </configurationOption>
  </binaryOptions>
  <numericOptions>
    <configurationOption>
      <name>threads</name>
      <minValue>1</minValue>
      <maxValue>8</maxValue>
      <stepFunction>threads * 2</stepFunction>
    </configurationOption>
  </numericOptions>
  <booleanConstraints>
    <constraint>!Encryption | !EngineB</constraint>
  </booleanConstraints>
  <nonBooleanConstraints></nonBooleanConstraints>
  <mixedConstraints></mixedConstraints>
</vm>
